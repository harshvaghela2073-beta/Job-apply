# Copy to backend/.env and adjust. Real environment variables override this file.
# Relative paths resolve against the backend/ directory, not the current working directory.

# SQLAlchemy URL. Default: SQLite file at backend/data/jobapply.db (directory created on startup).
DATABASE_URL=sqlite:///data/jobapply.db

# Comma-separated browser origins allowed to call the API (the frontend's URL).
CORS_ORIGINS=http://localhost:5173

# Generated, read-only markdown mirror of the profile and Template Library (both live in the
# database). The backend rewrites this whole file after every profile or template change.
PROFILE_PATH=../profile/CANDIDATE_PROFILE.md

# Resume PDF served by GET /api/profile/resume.
RESUME_PATH=../profile/resume/Harsh_Vaghela.pdf

# Automation caps shown on the dashboard (and enforced by the sources in later phases).
EASY_APPLY_DAILY_CAP=25
NAUKRI_DAILY_CAP=50
CONNECTION_NOTES_MONTHLY_CAP=250
INMAIL_MONTHLY_CAP=5
# Automatic emails to hiring posts per local day (only while "auto_send_email" is on in the app).
EMAIL_DAILY_CAP=20

# Gmail SMTP for those emails (STARTTLS). SMTP_APP_PASSWORD is a Google app password
# (Google Account > Security > App passwords), not your Gmail password; spaces in it are ignored.
# Keep the real values only in backend/.env (gitignored); the app never logs or returns the password.
# With no password, the email sender skips its runs and says so.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_FROM_NAME=
SMTP_APP_PASSWORD=

# Saved LinkedIn / Naukri logins: one Chrome profile directory per platform. Gitignored; never
# commit it. "Disconnect" in the app deletes a platform's directory.
BROWSER_PROFILES_DIR=../.browser-profiles

# Browser for logins and scans: "chrome" = the installed Google Chrome (nothing to download);
# "chromium" = Playwright's Chromium (run `.venv/bin/python -m playwright install chromium` first).
BROWSER_CHANNEL=chrome

# Background scans for jobs and hiring posts from today. Applying and sending happen only while
# their switch is on in the app (GET/PUT /api/settings; all off by default).
SCAN_ENABLED=true
# LinkedIn and Naukri are scanned separately; this is both groups' interval until set in the app.
SCAN_INTERVAL_MINUTES=30
# Scans run in an invisible (headless) browser; login windows are always visible.
SCAN_HEADLESS=true
# Page loads per scanner per run (with random 2-6 s pauses between them).
SCAN_MAX_PAGE_LOADS=20
# The logged-in LinkedIn job and post searches run at most this often (at most 10 page loads each
# time). Formerly LINKEDIN_SCAN_INTERVAL_MINUTES, which still works.
LINKEDIN_SEARCH_INTERVAL_MINUTES=60

# How long a login window waits for you to log in before it closes.
LOGIN_TIMEOUT_MINUTES=10

# Screenshots and HTML of pages where a scan or login check failed (on a server: the persistent disk).
DIAGNOSTICS_DIR=data/diagnostics

# App login, for a deployed backend. Empty APP_PASSWORD = no login (the local default). With it set,
# every /api request except /api/health and /api/auth/* needs a token from POST /api/auth/login.
# AUTH_SECRET signs those tokens (a long random string; derived from APP_PASSWORD when empty).
# Changing either one logs every device out. Keep the real values out of git.
APP_PASSWORD=
AUTH_SECRET=

# Your own Google Chrome data folder. "Connect" copies the LinkedIn / Naukri login from here
# (only cookies of those two sites; decrypting them needs the Keychain item "Chrome Safe Storage",
# and macOS asks you first).
CHROME_USER_DATA_DIR=~/Library/Application Support/Google/Chrome
